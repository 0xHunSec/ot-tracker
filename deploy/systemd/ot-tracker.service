[Unit]
Description=Chrome Origin Trial tracker sync
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/origintrial/tracker
Environment=PYTHONPATH=%h/origintrial/tracker/src
EnvironmentFile=-%h/.config/ot-tracker/discord.env
UMask=0077
ExecStart=/usr/bin/python3 -m ot_tracker --config %h/origintrial/tracker/config.toml sync
